# Local development defaults only. Do not use these credentials in production.
APP_ENV=development
# Explicit local-only identity mechanism; blocked when APP_ENV=production.
ENABLE_DEMO_AUTH=true
# Synthetic demo credentials. Replace for your local environment; never deploy them.
DEMO_ADMIN_TOKEN=demo-admin-local-token-change-me
DEMO_CREATOR_TOKEN=demo-creator-local-token-change-me
DEMO_VIEWER_TOKEN=demo-viewer-local-token-change-me
DEMO_CUSTOMER_B_TOKEN=demo-customer-b-local-token-change-me
# Local preview execution only; this flag is rejected in production.
ENABLE_LOCAL_RUNTIME=true
# Requires approved provider-backed model, explicit invocation grant and server credentials.
ENABLE_PROVIDER_RUNTIME=false
RUNTIME_TIMEOUT_SECONDS=30
MODEL_TIMEOUT_SECONDS=15
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LITELLM_LOCAL_MODEL_COST_MAP=True
POSTGRES_DB=bia_studio
POSTGRES_USER=bia
POSTGRES_PASSWORD=bia_local_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
API_PORT=8000
WEB_PORT=3000
# Used by the Next.js server, never exposed to browser JavaScript.
BACKEND_URL=http://127.0.0.1:8000
# JSON array. The Next.js proxy does not need CORS; this allows direct local clients.
CORS_ORIGINS=["http://localhost:3000"]
# Optional full SQLAlchemy URL (overrides POSTGRES_* in the API/Alembic).
# DATABASE_URL=postgresql+psycopg://bia:bia_local_only@127.0.0.1:55432/bia_studio

# Sprint 4: isolated local quality/governance roles; never production authentication.
DEMO_REVIEWER_TOKEN=local-reviewer-token-change-me-0000
DEMO_APPROVER_TOKEN=local-approver-token-change-me-0000
DEMO_AUDITOR_TOKEN=local-auditor-token-change-me-00000
EVALUATION_TIMEOUT_SECONDS=60

# Native embeddings: download with make knowledge-model; Docker uses a built-in path.
# No provider API key is needed for semantic retrieval.
# KNOWLEDGE_MODEL_PATH=.cache/knowledge-model
